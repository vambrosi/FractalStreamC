# Tour of the colour maps of the old FractalStream: pick
# one in the config panel and see it on a linear
# gradient, a cyclic gradient, the Mandelbrot set and a
# Julia set (escape time, optionally smooth, optionally
# with a phase shift above the real axis: "checkers").
# The old setup dialog held the `colorize` code; here it
# is a function in @global.
# Ported from FractalStream examples/color-test.fs

@config
.title = "Color test"
.width = 640
.height = 480
.escapeRadius = 10
# 1/150 per pixel in the old 450x402 window
mandelbrot.radius = 1.34
# 1/150 per pixel in the old 429x393 window
julia.radius = 1.31

@config "Pick a color scheme"
index : Z = 1 in ["rainbow", "arenberg", "romao",
                  "bamo", "broco", "corko", "viko",
                  "ice", "fire", "rose", "wheat",
                  "forest", "ocean", "winter", "spring",
                  "summer", "fall"] "Color scheme"
.maxIterations = 100 "Iterations limit"
speed : Z = 20 in 1..100 "Iterations per color cycle"
smooth : Bool = true "Use smooth coloring?"
checkers : Bool = false "Use checkers?"
checker_shift : R = 0.333 "Checker phase shift"
# (pick it in the Mandelbrot set)
.C = -0.11 + 0.78i "C"

@global
define colorize(t : R) = c : Color where
    if index == 1 then
        c = rainbow(t)
    else if index == 2 then
        c = palette("arenberg", t)
    else if index == 3 then
        c = palette("romao", t)
    else if index == 4 then
        c = palette("bamo", t)
    else if index == 5 then
        c = palette("broco", t)
    else if index == 6 then
        c = palette("corko", t)
    else if index == 7 then
        c = palette("viko", t)
    else if index == 8 then
        c = palette("ice", t)
    else if index == 9 then
        c = palette("fire", t)
    else if index == 10 then
        c = palette("rose", t)
    else if index == 11 then
        c = palette("wheat", t)
    else if index == 12 then
        c = palette("forest", t)
    else if index == 13 then
        c = palette("ocean", t)
    else if index == 14 then
        c = palette("winter", t)
    else if index == 15 then
        c = palette("spring", t)
    else if index == 16 then
        c = palette("summer", t)
    else if index == 17 then
        c = palette("fall", t)
    else
        c = .gray
    end
end

# escape-time parameter of an escaped orbit
# (z after n steps)
define escape_t(z, n : Z) = t : R where
    t = n
    if smooth then
        t = n + 1 - log(log(|z|^2) / (2 log(10))) / log(2)
    end
    t = t / speed
    if checkers and im z > 0 then
        t = t + checker_shift
    end
end

@viewer mandelbrot C "Mandelbrot set" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + C
end
color = .black
if z escapes then
    color = colorize(escape_t(z, .iterations))
end

@viewer julia z "Julia set" "Ctrl + 2"
while z not escapes do
    z = z^2 + .C
end
color = .black
if z escapes then
    color = colorize(escape_t(z, .iterations))
end

@viewer linear x "Linear gradient" "Ctrl + 3"
color = colorize(re x / 4)

@viewer cyclic w "Cyclic gradient" "Ctrl + 4"
color = colorize(arg w / (2 pi))
