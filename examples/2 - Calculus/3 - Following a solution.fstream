# ... continuing from c = c0: Newton's method starts
# from the seed only at the pixel of c0; every other
# pixel starts from a neighbour's solution, so the
# solution is followed across the picture (it grows
# from c0). Here the root of t^3 - 3t + c that is 0 at
# c = 0. The jumps are where the fill came around a
# branch point (c = 2 or -2) with another root.

@config
.title = "Following a root"
plane.radius = 4

@viewer plane c "A root, followed"
w := root t -> t^3 - 3 t + c with seed 0 ...
     continuing from c = 0
color = hsv(arg(w) / tau, 0.5, 0.8 + 0.2 cos(12 |w|))
# one continuing solve per view, in flat views
