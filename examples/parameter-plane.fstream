# Parameter plane and dynamical plane of
# z -> f(z) = z^2 + C, iterated until stop(z): escaping
# points get a smooth escape-time colouring (blue/green
# above the real axis, yellow/red below). The Trace tool
# draws orbits in the dynamical plane.
# Ported from FractalStream
# examples/parameter-plane.yaml

@config
.title = "Parametric complex dynamics"
.width = 512
.height = 512

@config "Parametric complex dynamics"
"Iterate z -> f(z, C) until stop(z, C):"
define f(z, C) = z^2 + C
define stop(z, C) = |z| > .escapeRadius

@config "Configuration"
# (pick it in the parameter plane)
.C = -0.1226 + 0.7449i "Selected value of C"
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Max. radius"

@global
define shade(z, n : Z) = c : Color where
    c1 := if im z > 0 then .blue else .yellow
    c2 := if im z > 0 then .green else .red
    s : R = n + 1 - log(log(|z|^2 / 2)) / log(2)
    s = cos(s pi / 10)^2
    c = blend(s, c1, c2)
end

@viewer parameter C "Parameter plane" "Ctrl + 1"
z := 0
while not stop(z, C) do
    z = f(z, C)
end
if stop(z, C) then
    color = shade(z, .iterations)
else
    color = .black
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
while not stop(z, .C) do
    z = f(z, .C)
end
if stop(z, .C) then
    color = shade(z, .iterations)
else
    color = .black
end

@dynamical.tool "Trace" "T" "timeline"
prevZ := z
while not stop(z, .C) do
    prevZ = z
    draw point at z
    z = f(z, .C)
    draw line between z and prevZ
end
on hide do
    erase
end
