# Newton's method for a function f entered by the user (z^3 - 1 by default): each point is
# coloured by the argument of the root it converges to, with bands counting the steps;
# black where it does not converge. The Trace tool draws the Newton orbit of a point.
# The old "setup" dialog asked for f; here, edit it in @global.
# Ported from FractalStream examples/newton.yaml (renamed: examples/newton.fstream exists)

@config
.title = "Roots of f"
.width = 512
.height = 512
.maxIterations = 100
.epsilon = 0.01               # "closeness"

@global
define f(z) = z^3 - 1         # "f(z) ="

define newton(z) = z - f(z) / derivative f at z

define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)
# the old built-in cycle(t, c1, c2): c2 at t = 0, c1 at t = 1/2, back to c2 at t = 1
define cycle(t : R, c1 : Color, c2 : Color) = mix(c2, c1, 1 - |2 fract(t) - 1|)

# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

@viewer plane z "Roots of f" "Ctrl + 1"
lastZ := 0
while z != lastZ do
    lastZ = z
    z = newton(z)
end

if z == lastZ then
    c : Color = rainbow(arg z / (2 pi))
    color = cycle(.iterations / 20, dark(c), light(c))
else
    color = .black
end

@plane.tool "Trace" "T" "timeline"
lastZ := 0
while z != lastZ do
    lastZ = z
    z = newton(z)
    draw point at lastZ
    draw line between lastZ and z
end
draw point at z
