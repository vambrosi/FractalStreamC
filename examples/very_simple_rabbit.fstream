# The Douady rabbit: the filled Julia set of
# z^2 - 0.12256 + 0.74486i, black on white.
# Ported from FractalStream
# examples/very_simple_rabbit.yaml

@config
.title = "Douady rabbit"
.width = 400
.height = 425
.maxIterations = 100
.escapeRadius = 10
# 1/128 per pixel in a 400x425 window
plane.radius = 1.5625

@viewer plane z "Douady rabbit" "Ctrl + 1"
while z not escapes do
    z = z^2 - 0.12256 + 0.74486i
end
color = if z escapes then .white else .black
