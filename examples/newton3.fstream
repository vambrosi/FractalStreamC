# Newton's method for the cubic with roots a, b and c:
# the basins of the three roots (red, green, blue;
# yellow if it converges elsewhere, black if it does
# not), shaded by the number of steps. "Trace" draws the
# Newton orbit of a point, "Move roots" drags the roots
# around.
# Ported from FractalStream examples/newton3.yaml

@config
.title = "Newton's method"
.width = 512
.height = 512

@config "Roots"
a := 1
b := cis(2 pi / 3)
c := cis(-2 pi / 3)

@config "Newton's method configuration"
.epsilon = 0.01 "closeness"
rad : R = 5 in 1..30 "grab radius (px)"
.maxIterations = 100 "Max. iterations"

@global
# the root being dragged by "Move roots": 1, 2, 3
# (0: none)
drag_target : Z = 0

define p(z) = (z - a) (z - b) (z - c)
define newton(z) = z - p(z) / derivative p at z

@viewer plane z "Roots of (z - a)(z - b)(z - c)" "Ctrl + 1"
lastZ := 0
do
    lastZ = z
    z = newton(z)
while z != lastZ end

col : Color = .yellow
if z == a then
    col = .red
else if z == b then
    col = .green
else if z == c then
    col = .blue
end
if z == lastZ then
    color = blend(cos(.iterations pi / 10)^2, dark(col), light(col))
else
    color = .black
end

@plane.tool "Trace" "T" "timeline"
lastZ := 0
do
    lastZ = z
    z = newton(z)
    draw point at lastZ
    draw line between lastZ and z
while z != lastZ end
draw point at z
on hide do
    erase
end

@plane.tool "Move roots" "M" "open_with"
# drawings stay until erased, as in the old tool
.keep = true
on show do
    erase
    draw point at a
    draw point at b
    draw point at c
end
on drag do
    if drag_target == 0 then
        if |.dragStart - a| < rad px then
            drag_target = 1
        else if |.dragStart - b| < rad px then
            drag_target = 2
        else if |.dragStart - c| < rad px then
            drag_target = 3
        end
    else if drag_target == 1 then
        a = z
    else if drag_target == 2 then
        b = z
    else if drag_target == 3 then
        c = z
    end
    erase
    draw point at a
    draw point at b
    draw point at c
end
on release do
    drag_target = 0
end
on hide do
    erase
end
