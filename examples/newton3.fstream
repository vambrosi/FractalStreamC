# Newton's method for the cubic with roots a, b and c: the basins of the three roots
# (red, green, blue; yellow if it converges elsewhere, black if it does not), shaded by
# the number of steps. "Trace" draws the Newton orbit of a point, "Move roots" drags the
# roots around.
# Ported from FractalStream examples/newton3.yaml

@config
.title = "Newton's method"
.width = 512
.height = 512
.maxIterations = 100
.epsilon = 0.01               # "closeness"
a := 1
b := cis(2 pi / 3)
c := cis(-2 pi / 3)
rad : R = 8 in 1..30          # "grab radius (px)"

@global
define p(z) = (z - a) (z - b) (z - c)
define newton(z) = z - p(z) / derivative p at z

define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)

@viewer plane z "Roots of (z - a)(z - b)(z - c)" "Ctrl + 1"
lastZ := 0
do
    lastZ = z
    z = newton(z)
while z != lastZ end

col : Color = .yellow
if z == a then
    col = .red
else if z == b then
    col = .green
else if z == c then
    col = .blue
end
if z == lastZ then
    color = mix(light(col), dark(col), cos(.iterations pi / 10)^2)
else
    color = .black
end

@plane.tool "Trace" "T" "timeline"
lastZ := 0
do
    lastZ = z
    z = newton(z)
    draw point at lastZ
    draw line between lastZ and z
while z != lastZ end
draw point at z

@plane.tool "Move roots" "M" "open_with"
# Drag a root: the root nearest to the mouse follows it while it is within the grab
# radius. (The old tool remembered which root the drag started on; here the root is
# found again at every step, so drag slowly. The px size is estimated from the radius
# of the view, 256 pixels in the initial 512x512 window.)
grab : R = rad plane.radius / 256
da : R = |z - a|
db : R = |z - b|
dc : R = |z - c|
if da < grab and da <= db and da <= dc then
    a = z
else if db < grab and db <= dc then
    b = z
else if dc < grab then
    c = z
end
draw circle at a with radius rad px and color .red
draw circle at b with radius rad px and color .green
draw circle at c with radius rad px and color .blue
