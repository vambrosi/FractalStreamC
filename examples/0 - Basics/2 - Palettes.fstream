# The palettes. Each row is palette("name", t) for t
# from 0 (left) to 1 (right), in the order of the code,
# top to bottom. All repeat with period 1 in t, so
# palette("ice", n / 30) cycles every 30 steps.

@config
.title = "Palettes"
chart.center = 0.5 + 0.5i
chart.radius = 0.55

@viewer chart z "Palettes"
t := re z                   # the chart is the unit square
row := 16 - floor(17 im z)  # 17 rows, 0 at the top
if t < 0 or t > 1 or row < 0 or row > 16 then
    return                  # outside the chart: black
end
# "..." at the end of a line: the statement goes on;
# rainbow(t) is palette("rainbow", t)
color = if row == 0 then rainbow(t) ...
    # cyclic (the two ends meet):
    else if row == 1 then palette("arenberg", t) ...
    else if row == 2 then palette("romao", t) ...
    else if row == 3 then palette("bamo", t) ...
    else if row == 4 then palette("broco", t) ...
    else if row == 5 then palette("corko", t) ...
    else if row == 6 then palette("viko", t) ...
    # there and back (t and 1 - t look the same):
    else if row == 7 then palette("ice", t) ...
    else if row == 8 then palette("fire", t) ...
    else if row == 9 then palette("wheat", t) ...
    else if row == 10 then palette("rose", t) ...
    else if row == 11 then palette("forest", t) ...
    else if row == 12 then palette("ocean", t) ...
    else if row == 13 then palette("winter", t) ...
    else if row == 14 then palette("spring", t) ...
    else if row == 15 then palette("summer", t) ...
    else palette("fall", t)
