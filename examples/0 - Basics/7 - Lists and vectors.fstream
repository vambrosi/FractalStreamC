# Lists and vectors. Each c in the Mandelbrot set is
# coloured by the period of the cycle its orbit settles
# on, read from a list of the orbit's last points.

@config
.title = "Periods"
.maxIterations = 500
plane.center = -0.6
plane.radius = 1.4

@viewer plane c "Periods"
z := 0
for k in 1..400 do              # settle on the cycle
    z = z^2 + c
end
if z escapes then
    color = gray(0.1)
    return
end
L : List of C = []              # up to 64 items (List of C
for k in 1..24 do               # up to 1000: more)
    z = z^2 + c
    append(L, z)                # add z; clear(L) empties L
end
p := 0                          # the period: L[-1] (last
for q in 1..|L| - 1 do          # item) seen q steps before
    if p == 0 and |L[-1] - L[-1 - q]| < 1e-4 then
        p = q                   # (|L|: the number of items)
    end
end
m := 0                          # the cycle's centre:
for w in L do                   # for each item of L
    m += w / |L|
end
# a vector of 3 reals (the type Color is R^3)
v : R^3 = [0.5 + 0.5 cos(p), 0.5 + 0.5 cos(p + 2),
           0.5 + 0.5 cos(p + 4)]
v[3] = v[3] * (0.6 + 0.4 fract(|m|))   # entries: v[1]...
# length(v): 3 entries; |v|: Euclidean length; dot(u, v)
light := dot(v, [0.3, 0.6, 0.1])
color = if p == 0 then .black else v * (0.5 + light)
