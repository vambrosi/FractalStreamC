# The complex Hénon map (x, y) -> (x^2 + b - a y, x), in the style of FractalStream 1.0:
# the parameter plane is the a-plane (a = c, b fixed). Each orbit starts at the fixed
# point (p, p) moved by zoom z along the expanding eigenvector (lambda, 1), with z = 0 in
# the parameter plane and z = the pixel in the dynamical plane, and is coloured by escape
# time (1.0 coloured the reported x with settings kept in the app, not in the script).
# Ported from FractalStream notes/fractalstream-1.0-scripts/henona.txt

@config
.title = "Hénon map, a-plane"
.maxIterations = 100
.escapeRadius = 10
.c = 0.3                      # the a of the dynamical plane (pick it in the a-plane)
b := 0.6 + 0.2i               # "default b to 0.6 + 0.2i."
zoom : R = 0.001              # "default zoom to 0.001."

@global
# the old built-in cycle(t, c1, c2): c2 at t = 0, c1 at t = 1/2, back to c2 at t = 1
define cycle(t : R, c1 : Color, c2 : Color) = mix(c2, c1, 1 - |2 fract(t) - 1|)

# iterate from the fixed point moved by `step` along the unstable direction; the result
# is the number of steps before x escapes (.maxIterations if it does not)
define henon(a, b, step) = n : Z where
    aa := (a + 1) / 2
    disc := aa^2 - b
    p := sqrt(disc) + aa
    disc = p^2 - a
    lambda := sqrt(disc) + p
    x := p + lambda step
    y := p + step
    do
        t := x
        x = x^2 + b - a y
        y = t
    while x not escapes end
    n = .iterations
    if x not escapes then
        n = .maxIterations
    end
end

@viewer parameter c "a-plane" "Ctrl + 1"
n : Z = henon(c, b, 0)        # "set a to c."
color = .black
if n < .maxIterations then
    color = cycle(n / 10, .blue, .white)
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
n : Z = henon(.c, b, z zoom)
color = .black
if n < .maxIterations then
    color = hsv(n / 10, 0.8, 1)
end
