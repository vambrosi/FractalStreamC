# Internal rays of hyperbolic components: the orbit is followed onto its attracting cycle,
# whose period and multiplier lambda are measured; the parameter space is coloured by
# arg(lambda), the dynamical plane by the angle in the linearising coordinate (den sectors),
# escaping points are blue/yellow. The Trace tool draws the orbit of a point onto its cycle.
# Ported from FractalStream examples/internal_rays.yaml

@config
.title = "Internal rays"
.width = 800
.height = 800
parameter.center = -0.5

@config "Internal Rays Setup"
define f(z, c) = z^2 + c
define f2(w, c) = (w^2 + c)^2 + c
define critical_point(c) = 0
degree : Z = 2 "Degree"

@config "Internal Rays"
continuous : Bool = false               # continuous colouring of the angle, or den sectors
den : Z = 3 in 1..24 "denominator"

@config "Dynamics"
.c = 0 "c"                              # (pick it in the parameter space)
.maxIterations = 300 "max iterations"
.escapeRadius = 100 "escape radius"
.epsilon = 0.00001 "vanishing radius"
extra_iterations : Z = 1 "extra iterations"

@config "Orbit Tracker"
start := 0 "orbit start"                # (set by the Trace tool)

@global
# the colour of the orbit of z0 under f_c; `dynamic` chooses the angle to show
define picture(z0, c, dynamic : Bool) = col : Color where
    z := z0
    w := z
    do
        z = f(z, c)
        w = f2(w, c)
    while not (|z - w| vanishes or z escapes) end

    if .stuck then
        col = .black
    else if z escapes then
        col = if im z > 0 then .blue else .yellow
        s : R = .iterations + 1 - log(log(|z|)) / log(degree)
        col = blend(cos(s pi)^2, light(col), dark(col))
    else
        lambda := 1
        do
            z = f(z, c)
            lambda = (derivative u -> f(u, c) at z) lambda
        while not (|z - w| vanishes) end
        period : Z = .iterations

        # (the original's loop here never increased its counter, so it ran until
        # .maxIterations; this runs the intended extra_iterations * period steps)
        for k in 1..extra_iterations period do
            w = f2(w, c)
        end

        z = z0
        while not (|z - w| vanishes) do
            z = f(z, c)
        end
        preperiod : Z = .iterations

        s : R = preperiod / period
        theta : R = arg lambda
        if dynamic then
            theta = arg(z - w) - s arg lambda
        end
        ptheta : R = (theta / (2 pi)) mod 1

        if continuous then
            col = rainbow((ptheta den) mod 1)
        else
            col = if ptheta mod (1 / den) > 0.5 / den then .red else rgb(0, 1, 1)
        end

        s_adjusted : R = s + 1 - log(|z - w|) / log(|lambda|)
        col = blend(cos(s_adjusted pi)^2, light(col), dark(col))
    end
end

# draw the orbit of z0 onto its attracting cycle, and mark the point w of the cycle that
# was found (the Trace tool)
define trace(z0, c) = w where
    z := z0
    w = z0
    do
        z = f(z, c)
        w = f2(w, c)
    while not (|z - w| vanishes or z escapes) end

    if |z - w| vanishes then
        z = z0
        lastZ := z
        while not (|z - w| vanishes) do
            lastZ = z
            z = f(z, c)
            draw point at lastZ
            draw line between lastZ and z
        end
    end
    draw circle at w with radius .epsilon and color .green
end

@viewer parameter c "Parameter space" "Ctrl + 1"
color = picture(critical_point(c), c, false)

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
color = picture(z, .c, true)

@dynamical.tool "Trace" "T" "timeline"
on press do
    start = z
    trace(start, .c)
end
on drag do
    start = z
    trace(start, .c)
end
on show do                    # redraw the orbit of start when the configuration changes
    trace(start, .c)          # (the original's redraw restarted from 0 instead of start)
end
