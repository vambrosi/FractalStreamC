# A parameter picture from a thesis: for each p, a
# rational recursion (x, y) is run from
# (p + 1, p (p + 1)^2 + 1) until it reaches (0, 1); the
# number of steps sets the shade, and the hue tells
# whether the critical orbit of z -> p z^2 + 1 escapes
# (red) or not (green).
# Ported from FractalStream examples/sarah-thesis2.yaml

@config
.title = "Sarah thing"
.width = 600
.height = 600
# 1/128 per pixel in a 600x600 window
plane.radius = 2.34

@config "Standard settings"
.maxIterations = 100 "Iteration limit"
.escapeRadius = 10 "Escape radius"
.epsilon = 0.0001 "Vanishing radius"

@viewer plane z "Sarah thing" "Ctrl + 1"
p := z
x := z + 1
y := z (z + 1)^2 + 1

do
    x = (y^2 - 1) / y^2
    y = (y^2 - x^2) / y^2
while not (x == 0 and y == 1) end
saved_count : Z = .iterations

z = 0
while z not escapes do
    z = p z^2 + 1
end

if z escapes then
    color = cycle(saved_count / 20, dark(.red), light(.red))
else
    color = cycle(saved_count / 20, dark(.green), light(.green))
end
