# A parameter picture from a thesis: for each p, a rational recursion (x, y) is run from
# (p + 1, p (p + 1)^2 + 1) until it reaches (0, 1); the number of steps sets the shade,
# and the hue tells whether the critical orbit of z -> p z^2 + 1 escapes (red) or not (green).
# Ported from FractalStream examples/sarah-thesis2.yaml

@config
.title = "Sarah thing"
.width = 600
.height = 600
.maxIterations = 100
.escapeRadius = 10
.epsilon = 0.0001             # "Vanishing radius"
plane.radius = 2.34           # 1/128 per pixel in a 600x600 window

@global
define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)
# the old built-in cycle(t, c1, c2): c2 at t = 0, c1 at t = 1/2, back to c2 at t = 1
define cycle(t : R, c1 : Color, c2 : Color) = mix(c2, c1, 1 - |2 fract(t) - 1|)

@viewer plane z "Sarah thing" "Ctrl + 1"
p := z
x := z + 1
y := z (z + 1)^2 + 1

do
    x = (y^2 - 1) / y^2
    y = (y^2 - x^2) / y^2
while not (x == 0 and y == 1) end
saved_count : Z = .iterations

z = 0
while z not escapes do
    z = p z^2 + 1
end

if z escapes then
    color = cycle(saved_count / 20, dark(.red), light(.red))
else
    color = cycle(saved_count / 20, dark(.green), light(.green))
end
