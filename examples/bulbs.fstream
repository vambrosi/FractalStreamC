# The Mandelbrot set, with a "Bulb info" tool: click a point of the Mandelbrot set to find
# the period of its attracting cycle, which is written at the point ("X": outside the
# Mandelbrot set, "?": period larger than the maximum period). The labels stay until
# "Erase annotations".
# Ported from FractalStream examples/bulbs.yaml

@config
.title = "Mandelbrot set"
.width = 512
.height = 512

@config "Configuration"
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Escape radius"

@config "Bulb period finder"
"Click on points of the Mandelbrot set to find the period of the attracting cycle."
"Points outside of the Mandelbrot set will result in \"X\""
"Cycles exceeding the maximum period will result in \"?\""

@config "Settings"
warmup : Z = 10000 "Warmup iterations"
max_period : Z = 1000 "Maximum period"
tol : R = 0.0001 "Tolerance when checking for cycles"

@viewer plane C "Mandelbrot set" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + C
end
if z escapes then
    color = rainbow(.iterations / 20)
else
    color = .black
end

@plane.tool "Bulb info" "B" "info"
.panning = true               # clicks only: dragging pans
.keep = true                  # the labels build up
# Iterate z^2 + C many times so that we end up with z close to one of the points on
# the attracting cycle.
z := 0
for k in 1..warmup do
    if z escapes then
        break
    end
    z = z^2 + C
end

# Now that z is on the attracting cycle (or at least very near it), count how many times
# we need to apply z^2 + C until we get back to z again.
if z escapes then
    draw text "X" at C
else
    target := z
    n : Z = 0
    for k in 1..max_period do
        z = z^2 + C
        n = k
        if |z - target| < tol then
            break
        end
    end
    if |z - target| < tol then
        draw text n at C
    else
        draw text "?" at C
    end
end

@plane.tool "Erase annotations" "E" "delete" button
erase "Bulb info"
