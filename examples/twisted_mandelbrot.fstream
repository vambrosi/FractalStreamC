# z -> z^2 + C composed with a Dehn twist of the annulus r0 < |z - twist_center| < r1, in
# the parameter space and in the dynamical plane, with smooth escape-time colouring
# (blue/green above the real axis, yellow/red below). "Trace" draws an orbit; "Dehn twist"
# drags the centre of the twist or either of its circles.
# The old "setup" dialog asked for f and stop; here, edit them in @global.
# Ported from FractalStream examples/twisted_mandelbrot.yaml

@config
.title = "Twisted Mandelbrot set"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10            # "Max. radius"
.C = -0.1226 + 0.7449i        # "Selected value of C" (pick it in the parameter space)
twist_center := -0.267 + 0.478i    # Dehn twist: "Center of twist"
r0 : R = 0.2                  #   "Inner radius"
r1 : R = 0.5                  #   "Outer radius"

@global
define f(z, C) = z^2 + C                   # "Iterate f(z) ="
define stop(z, C) = |z| > .escapeRadius    # "until"

# one step: f, then the Dehn twist
define step(z, C) = w where
    w = f(z, C)
    d : R = |w - twist_center|
    if d > r0 and d < r1 then
        theta : R = 2 pi (d - r0) / (r1 - r0)
        w = cis(theta) (w - twist_center) + twist_center
    end
end

define shade(z, n : Z) = c : Color where
    c1 : Color = .yellow
    c2 : Color = .red
    if im z > 0 then
        c1 = .blue
        c2 = .green
    end
    s : R = n + 1 - log(log(|z|^2) / (2 log(.escapeRadius))) / log(2)
    s = cos(s pi / 10)^2
    c = mix(c2, c1, s)
end

@viewer parameter C "Parameter space" "Ctrl + 1"
z := 0
while not stop(z, C) do
    z = step(z, C)
end
if .stuck then
    color = .black
else
    color = shade(z, .iterations)
end

@viewer dynamical z "Twisted dynamical plane" "Ctrl + 2"
while not stop(z, .C) do
    z = step(z, .C)
end
if .stuck then
    color = .black
else
    color = shade(z, .iterations)
end

@dynamical.tool "Trace" "T" "timeline"
prevZ := z
for k in 1..100 do
    if stop(z, .C) then
        break
    end
    prevZ = z
    draw point at z
    z = step(z, .C)
    draw line between z and prevZ
end

@dynamical.tool "Dehn twist" "D" "rotate_right"
# Drag the centre, or either circle, of the twist. (The old tool remembered what the drag
# started on; here it is found again at every step, so drag slowly. The px size is
# estimated from the radius of the view, 256 pixels in the initial 512x512 window.)
eps : R = 5 dynamical.radius / 256
d : R = |z - twist_center|
if d < eps then
    twist_center = z
else if |d - r0| < eps then
    r0 = d
else if |d - r1| < eps then
    r1 = d
end
draw point at twist_center with color .red
draw circle at twist_center with radius r0
draw circle at twist_center with radius r1
