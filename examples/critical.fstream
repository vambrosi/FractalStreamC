# Parameter plane of the cubic family z -> z^3 + c z^2 + 1, coloured by what happens to
# the orbit of its free critical point (found by Newton's method with `critical`).

@config
.title = "Critical orbits of cubics"
.maxIterations = 200
.escapeRadius = 100
plane.radius = 3

@viewer plane c "Parameter plane" "Ctrl + 1"
w := critical z -> z^3 + c z^2 + 1 with seed -c
if .stuck then           # Newton's method did not converge
    color = .gray
    return
end
while w not escapes do
    w = w^3 + c w^2 + 1
end
if .stuck then
    color = .black
else
    color = hsv(.iterations / 25 + 0.55, 0.65, 1)
end

@tool "Critical orbit" "O"
# click a parameter: draw the free critical point and the start of its orbit
c := .lastClick
w := critical z -> z^3 + c z^2 + 1 with seed -c
for k in 1..30 do
    w2 := w^3 + c w^2 + 1
    draw line between w and w2 with color .white
    w = w2
end
