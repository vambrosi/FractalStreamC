# Newton's method for the polynomial with the given roots.
# Use the "Add root" tool to click new roots into the picture,
# and "Clear roots" to start over.

@config
.title = "Newton's method"
.maxIterations = 100
plane.radius = 1.5

@global
roots : List of C = [1, cis(tau / 3), cis(2 tau / 3)]

@viewer plane z "Newton basins" "Ctrl + 1"
# z <- z - p(z)/p'(z), and p'/p is the sum of 1/(z - r) over the roots
for k in 1..100 do
    s := 0
    arrived := false
    for r in roots do
        if z - r vanishes then
            arrived = true
        end
        s += 1 / (z - r)
    end
    if arrived then
        break
    end
    z -= 1 / s
end
steps : Z = .iterations
# colour by the nearest root, darker when convergence was slow
best : Z = 1
for j in 1..|roots| do
    if |z - roots[j]| < |z - roots[best]| then
        best = j
    end
end
color = hsv(best / |roots|, 0.7, 1 - min(steps / 40, 0.8))

@tool "Add root" "A"
append(roots, .lastClick)
for r in roots do
    draw circle at r with radius 5 px and color .white
end

@tool "Clear roots" "C"
clear(roots)
