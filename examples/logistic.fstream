# Bifurcation diagram of the logistic map x -> r x
# (1 - x): the horizontal axis is r, the vertical axis
# is x. A point (r, x0) is dark when the orbit of x0,
# after a warm-up, comes back close to x0, that is when
# x0 is (near) the attractor.
# Ported from FractalStream examples/logistic.yaml

@config
.title = "Bifurcation diagram for the logistic map"
.width = 512
.height = 512

@config "Configuration"
# the orbit is back when |x - x0| < .epsilon
.epsilon = 0.0001 "tolerance"
# distances above this are white
outer : R = 0.01 "outer tolerance"
.maxIterations = 1000 "Max. iterations"
warmup : Z = 1000 "Warmup iterations"

@viewer plane z "Logistic map" "Ctrl + 1"
x : R = im z
x0 : R = x
r : R = re z
best : R = outer

for k in 1..warmup do
    x = r x (1 - x)
end

while x != x0 do
    x = r x (1 - x)
    if |x - x0| < best then
        best = |x - x0|
    end
end
color = blend(best / outer, .white, .black)
