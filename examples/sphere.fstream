# Newton's method for z^3 - 1 on the Riemann sphere.
# Drag to rotate the sphere, use the wheel to zoom
# around the mouse.
@config
.title = "Newton's method on the Riemann sphere"
.maxIterations = 60
sphere.radius = 1.5

@viewer sphere z "Riemann sphere" "Ctrl + 1" projective
for k in 1..60 do
    step := (z^3 - 1) / (3 z^2)
    z -= step
    if step vanishes then
        break
    end
end
color = hsv(arg(z) / tau + 0.1, 0.6, 1 - .iterations / 80)
