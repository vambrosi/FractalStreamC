# The Mandelbrot set with the bifurcation diagram of the logistic map x -> r x (1 - x)
# drawn over it (inverted colours), lined up so that the real parameter c of z^2 + c and
# the r of the logistic map are conjugate (r = 1 + sqrt(1 - 4c)). Use the "Vertical line"
# tool to compare points of the Mandelbrot set and of the bifurcation diagram.
# Ported from FractalStream examples/mandelbrot-bifurcations.yaml

@config
.title = "Mandelbrot set + logistic map bifurcations"
.width = 700
.height = 500
.maxIterations = 1000
.escapeRadius = 10
plane.center = -0.8 + 0.3i
plane.radius = 1.25           # 0.005 per pixel in a 700x500 window
warmup : Z = 500              # Bifurcation diagram: "Warmup iterations"
cycle_length : Z = 200        # "Cycle check iterations"
offset : R = 0.5              # "Vertical offset"

@global
# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

@viewer plane C "Mandelbrot set" "Ctrl + 1"
# the size of a pixel: the old viewer knew it; here it is estimated from the view radius
# (250 pixels per radius in the initial 700x500 window)
pixel : R = plane.radius / 250

# Draw the Mandelbrot set
z := 0
while z not escapes do
    z = z^2 + C
end
if z escapes then
    color = mix(.white, rainbow(.iterations / 20), 0.2)
else
    color = .black
end

# Overlay a bifurcation diagram for the logistic map
if re C >= -2 and re C <= 1/4 and im C > offset and im C < offset + 1 then
    r : R = 1 + sqrt(1 - 4 re C)
    x : R = im C - offset
    x0 : R = x
    for k in 1..warmup do
        x = r x (1 - x)
    end
    hit := false
    for k in 1..cycle_length do
        if |x - x0| < pixel then
            hit = true
            break
        end
        x = x r (1 - x)
    end
    if hit then
        color = .white - color
    end
end

@plane.tool "Vertical line" "V" "height"
draw line between re C + 2i and re C - 2i with color .red
