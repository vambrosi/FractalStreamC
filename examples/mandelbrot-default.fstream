# The default session of the old app: the parameter plane and the dynamical plane of
# z -> f(z) = z^2 + C, iterated until stop(z) holds, with a tool that traces orbits.
# The old "setup" dialog asked for f and stop; here, edit them in @global.
# Ported from FractalStream examples/mandelbrot-default.fs

@config
.title = "Parametric complex dynamics"
.width = 569
.height = 586
.maxIterations = 100
.escapeRadius = 10            # "Max. radius"
.C = 1.4140625 - 0.7890625i   # "Selected value of C" (pick it in the parameter plane)

@global
define f(z, C) = z^2 + C                   # "Iterate f(z) ="
define stop(z, C) = |z| > .escapeRadius    # "until"

# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

@viewer parameter C "Parameter plane" "Ctrl + 1"
z := 0
while not stop(z, C) do
    z = f(z, C)
end
if stop(z, C) then
    color = rainbow(.iterations / 20)
else
    color = .black
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
while not stop(z, .C) do
    z = f(z, .C)
end
if stop(z, .C) then
    color = rainbow(.iterations / 20)
else
    color = .black
end

@dynamical.tool "Trace" "T" "timeline"
prevZ := z
while not stop(z, .C) do
    prevZ = z
    draw point at z
    z = f(z, .C)
    draw line between z and prevZ
end
