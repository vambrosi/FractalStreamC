# The default session of the old app: the parameter plane and the dynamical plane of
# z -> f(z) = z^2 + C, iterated until stop(z) holds, with a tool that traces orbits.
# Ported from FractalStream examples/mandelbrot-default.fs

@config
.title = "Parametric complex dynamics"
.width = 569
.height = 586

@config "Parametric complex dynamics"
"Iterate z -> f(z, C) until stop(z, C):"
define f(z, C) = z^2 + C
define stop(z, C) = |z| > .escapeRadius

@config "Configuration"
.C = 1.4140625 - 0.7890625i "Selected value of C"    # (pick it in the parameter plane)
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Max. radius"

@global
@viewer parameter C "Parameter plane" "Ctrl + 1"
z := 0
while not stop(z, C) do
    z = f(z, C)
end
if stop(z, C) then
    color = rainbow(.iterations / 20)
else
    color = .black
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
while not stop(z, .C) do
    z = f(z, .C)
end
if stop(z, .C) then
    color = rainbow(.iterations / 20)
else
    color = .black
end

@dynamical.tool "Trace" "T" "timeline"
prevZ := z
while not stop(z, .C) do
    prevZ = z
    draw point at z
    z = f(z, .C)
    draw line between z and prevZ
end
on hide do
    erase
end
