# The Mandelbrot set tiled by Julia sets: the plane is
# cut into small squares, and each square shows
# (a zoom of) the Julia set of the parameter at its
# centre.
# Ported from FractalStream
# examples/tiled-mandelbrot.yaml

@config
.title = "Mandelbrot set tiled by Julia sets"
.width = 512
.height = 512

@config "Configuration"
.maxIterations = 100 "Iteration limit"
.escapeRadius = 10 "Escape radius"
size : R = 0.05 "Julia set size"
scale : R = 2.5 "Julia set zoom level"

@viewer plane w "Tiled Mandelbrot set" "Ctrl + 1"
x : R = re(w) mod size
y : R = im(w) mod size

C := w - (x + i y) + (1 + i) size / 2
z := (x + i y - (1 + i) size / 2) scale / size

while z not escapes do
    z = z^2 + C
end

if .stuck then
    color = .black
else
    m : R = .iterations + 1 -
            log(log(|z|^2) / (2 log(.escapeRadius))) / log(2)
    color = rainbow(m / 20)
end
