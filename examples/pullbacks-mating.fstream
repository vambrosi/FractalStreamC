# The family z -> (z^2 - C) / (z^2 - 1) (critical points 0 and infinity; infinity -> 1 ->
# infinity is a superattracting 2-cycle), studied by pulling paths back. C-plane: escape
# time of the critical value C. Dynamics: escape time of z. Tools: "Preimages" marks a point
# and its two preimages; "Mark orbit of critical point" draws the orbit of 0 and the point
# 1; "Pullback" drags a path and draws its two lifts (preimages followed continuously).
# Ported from FractalStream examples/pullbacks-mating.yaml

@config
.title = "Pullbacks"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10
.epsilon = 0.0001             # "Tolerance"
.C = 0.5 + 0.8660254038i      # "C = " (pick it in the C-plane)
color1 : Color = .white       # "Selected point"
color2 : Color = .red         # preimage 1
color3 : Color = .yellow      # preimage 2
orbit_lines : Bool = false    # Mark orbit: "Draw lines between iterations?"
zero_orbit_color : Color = .blue
one_color : Color = .green
pre1 := 0                     # Preimages: the last two preimages
pre2 := 0

@global
define f(z, C) = (z^2 - C) / (z^2 - 1)

define dark(c : Color) = mix(c, .black, 1/3)
# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

# the path dragged with the Pullback tool and its two lifts (at most 64 points each)
path : List of C = []
lift1 : List of C = []
lift2 : List of C = []

@viewer cplane C "C-plane" "Ctrl + 1"
z := C
while z not escapes do
    z = f(z, C)
end
if .stuck then
    color = .black
else
    color = rainbow(.iterations / 20)
end

@viewer dynamics z "Dynamics" "Ctrl + 2"
while z not escapes do
    z = f(z, .C)
end
if .stuck then
    color = .black
else
    color = dark(rainbow(.iterations / 20))
end

@dynamics.tool "Preimages" "I" "call_split"
pre1 = sqrt((z - .C) / (z - 1))
pre2 = -pre1
draw point at z with color color1
draw point at pre1 with color color2
draw point at pre2 with color color3

@dynamics.tool "Mark orbit of critical point" "O" "track_changes"
.panning = true
# (the old tool drew whenever its settings changed; here, click anywhere)
draw point at 1 with color one_color
w := 0
last_w := w
do
    draw point at w with color zero_orbit_color
    if orbit_lines then
        draw line between last_w and w with color zero_orbit_color
        last_w = w
    end
    w = f(w, .C)
while w != 0 end

@dynamics.tool "Pullback" "U" "gesture"
# Drag to draw a path; its two lifts follow it continuously. Clicking away from the end
# of the path starts a new one (the old tool did this at the end of each drag).
p1 := sqrt((z - .C) / (z - 1))
p2 := -p1
n : Z = |path|
if n > 0 and |z - path[n]| > dynamics.radius / 10 then
    clear(path)
    clear(lift1)
    clear(lift2)
    n = 0
end
if n == 0 then
    append(path, z)
    append(lift1, p1)
    append(lift2, p2)
else if |z - path[n]| > dynamics.radius / 200 then
    # make p1 the preimage closest to the end of the first lift
    if |lift1[n] - p2| < |lift1[n] - p1| then
        tmp := p1
        p1 = p2
        p2 = tmp
    end
    if n == 64 then
        # the lists are full: keep every other point
        old := path
        old1 := lift1
        old2 := lift2
        clear(path)
        clear(lift1)
        clear(lift2)
        for k in 1..32 do
            append(path, old[2 k])
            append(lift1, old1[2 k])
            append(lift2, old2[2 k])
        end
    end
    append(path, z)
    append(lift1, p1)
    append(lift2, p2)
end
for k in 2..|path| do
    draw line between path[k - 1] and path[k] with color color1
    draw line between lift1[k - 1] and lift1[k] with color color2
    draw line between lift2[k - 1] and lift2[k] with color color3
end
draw point at z with color color1
