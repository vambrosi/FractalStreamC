# The family z -> (z^2 - C) / (z^2 - 1) (critical points 0 and infinity; infinity -> 1 ->
# infinity is a superattracting 2-cycle), studied by pulling paths back. C-plane: escape
# time of the critical value C. Dynamics: escape time of z. Tools: "Preimages" marks a point
# and its two preimages; "Mark orbit of critical point" draws the orbit of 0 and the point
# 1; "Pullback" drags paths and draws their two lifts (preimages followed continuously).
# Ported from FractalStream examples/pullbacks-mating.yaml

@config
.title = "Pullbacks"
.width = 512
.height = 512

@config "Configuration"
.C = 0.5 + 0.8660254038i "C"       # (pick it in the C-plane)
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Escape radius"
.epsilon = 0.0001 "Tolerance"
color1 : Color = .white "Selected point"

@config "Preimages"
pre1 := 0 "Preimage 1"
color2 : Color = .red "Preimage 1 color"
pre2 := 0 "Preimage 2"
color3 : Color = .yellow "Preimage 2 color"

@config "Postcritical points"
orbit_lines : Bool = false "Draw lines between iterations?"
zero_orbit_color : Color = .blue "Orbit of 0"
one_color : Color = .green "Mark 1"

@config "Pullback"
follow : Bool = false "Follow previous preimages?"
last_z := 0 "Selected point"
last_pre1 := 0 "Preimage 1"
last_pre2 := 0 "Preimage 2"

@global
define f(z, C) = (z^2 - C) / (z^2 - 1)

@viewer cplane C "C-plane" "Ctrl + 1"
z := C
while z not escapes do
    z = f(z, C)
end
if .stuck then
    color = .black
else
    color = rainbow(.iterations / 20)
end

@viewer dynamics z "Dynamics" "Ctrl + 2"
while z not escapes do
    z = f(z, .C)
end
if .stuck then
    color = .black
else
    color = dark(rainbow(.iterations / 20))
end

@dynamics.tool "Preimages" "I" "call_split"
pre1 = sqrt((z - .C) / (z - 1))
pre2 = -pre1
draw point at z with color color1
draw point at pre1 with color color2
draw point at pre2 with color color3
on hide do
    erase
end

@dynamics.tool "Mark orbit of critical point" "O" "track_changes"
.panning = true
on show do
    draw point at 1 with color one_color
    w := 0
    last_w := w
    do
        draw point at w with color zero_orbit_color
        if orbit_lines then
            draw line between last_w and w with color zero_orbit_color
            last_w = w
        end
        w = f(w, .C)
    while w != 0 end
end

@dynamics.tool "Erase postcritical points" "Shift + O" "delete_sweep" button
erase "Mark orbit of critical point"

@dynamics.tool "Pullback" "U" "gesture"
.keep = true                  # the paths build up until "Erase"
on drag do
    pre_1 := sqrt((z - .C) / (z - 1))
    pre_2 := -pre_1
    if follow then
        draw line between last_z and z with color color1
        last_z = z
        # make sure that pre_1 is the preimage closest to last_pre1
        if |last_pre1 - pre_2| < |last_pre1 - pre_1| then
            (pre_1, pre_2) = (pre_2, pre_1)
        end
        draw line between last_pre1 and pre_1 with color color2
        last_pre1 = pre_1
        draw line between last_pre2 and pre_2 with color color3
        last_pre2 = pre_2
    else
        draw point at z with color color1
        last_z = z
        draw point at pre_1 with color color2
        last_pre1 = pre_1
        draw point at pre_2 with color color3
        last_pre2 = pre_2
        follow = true
    end
end
on release do
    follow = false
end

@dynamics.tool "Erase" "E" "delete" button
erase "Pullback"
follow = false
