# The Julia set of z^2 + C for a C set in the config panel, with a tool that traces orbits.
# Ported from FractalStream examples/basic_julia.yaml

@config
.title = "Julia set"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10
C := -0.11 + 0.78i            # f(z) = z^2 + C
p : R = 0.5 in 0.05..2        # "Brightness"

@viewer plane z "Julia set" "Ctrl + 1"
while z not escapes do
    z = z^2 + C
end
if .stuck then
    color = .black
else
    # blend((iterations / max_iters)^p, dark blue, white)
    color = mix(.white, mix(.blue, .black, 1/3), (.iterations / .maxIterations)^p)
end

@plane.tool "Trace" "T" "timeline"
prevZ := z
while z not escapes do
    prevZ = z
    draw point at z
    z = z^2 + C
    draw line between z and prevZ
end
