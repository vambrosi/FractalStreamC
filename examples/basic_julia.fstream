# The Julia set of z^2 + C for a C set in the config panel, with a tool that traces orbits.
# Ported from FractalStream examples/basic_julia.yaml

@config
.title = "Julia set"
.width = 512
.height = 512

@config "Configuration"
C := -0.11 + 0.78i "f(z) = z^2 +"
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Escape radius"
p : R = 0.5 in 0.05..2 "Brightness"

@viewer plane z "Julia set" "Ctrl + 1"
while z not escapes do
    z = z^2 + C
end
if .stuck then
    color = .black
else
    color = blend((.iterations / .maxIterations)^p, dark(.blue), .white)
end

@plane.tool "Trace" "T" "timeline"
prevZ := z
while z not escapes do
    prevZ = z
    draw point at z
    z = z^2 + C
    draw line between z and prevZ
end
