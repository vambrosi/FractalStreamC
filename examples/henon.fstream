# The complex Hénon map (x, y) -> (x^2 + b - a y, x),
# started at the fixed point (p, p) moved by a step
# along its unstable eigenvector (lambda, 1): coloured
# by escape time. In the a- and b-planes the step is 0
# (only rounding errors move the orbit); in the
# dynamical plane it is zoom z, which shows the unstable
# manifold of the fixed point.
# Ported from FractalStream examples/henon.yaml

@config
.title = "Hénon map"
.width = 512
.height = 512

@config "Configuration"
.a = 0.3 "a"                  # (pick it in the a-plane)
.b = 0.6 + 0.2i "b"           # (pick it in the b-plane)
zoom : R = 0.001
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Escape radius"

@global
# iterate the Hénon map from the fixed point moved by
# `step` along the unstable direction; returns whether
# it escaped and after how many steps
define henon(a, b, step) = (escaped : Bool, n : Z) where
    aa := (a + 1) / 2
    disc := aa^2 - b
    p := sqrt(disc) + aa
    disc = p^2 - a
    lambda := sqrt(disc) + p
    x := p + lambda step
    y := p + step
    do
        t := x
        x = x^2 + b - a y
        y = t
    while x not escapes end
    escaped = x escapes
    n = .iterations
end

@viewer aplane a "a-plane" "Ctrl + 1"
(escaped, n) := henon(a, .b, 0)
if escaped then
    color = cycle(n / 10, .blue, .white)
else
    color = .black
end

@viewer bplane b "b-plane" "Ctrl + 2"
(escaped, n) := henon(.a, b, 0)
if escaped then
    color = cycle(n / 10, .blue, .white)
else
    color = .black
end

@viewer dynamics z "Hénon dynamics" "Ctrl + 3"
(escaped, n) := henon(.a, .b, z zoom)
if escaped then
    color = rainbow(n / 10)
else
    color = .black
end
