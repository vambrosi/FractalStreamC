# External rays of the Mandelbrot set and of a quadratic Julia set, drawn by following
# the equipotentials inward with Newton's method (as in Sage's mandel_julia_helper).
# The parameter plane draws the parameter rays of angles p/q for p in param_ps, the
# dynamical plane the dynamic rays of angles p/q for p in dyn_ps (click anywhere).
# Ported from FractalStream examples/external_rays.yaml

@config
.title = "External rays"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10
.C = -0.11 + 0.78i            # f(z) = z^2 + C (pick it in the parameter plane)
param_ps : List of Z = [0, 1, 2]   # parameter rays: numerators
param_q : Z = 3                    #   and denominator
dyn_ps : List of Z = [1, 2, 4]     # dynamic rays: numerators
dyn_q : Z = 7                      #   and denominator
S : Z = 10                    # "Subdivisions per level set"
error : R = 0.0001            # "Step size"
iter_limit : Z = 100          # "Newton iteration limit"

@global
define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)

# smooth escape-time colouring: dark purple/green bands above/below the real axis
define shade(z, n : Z) = c : Color where
    # see https://linas.org/art-gallery/escape/ray.html
    m : R = n + 1 - log(log(|z|^2) / (2 log(.escapeRadius))) / log(2)
    base : Color = dark(.green)
    if im z > 0 then
        base = dark(.purple)
    end
    c = mix(light(base), base, cos(pi m / 20)^2)
end

@viewer parameter C "Parameter plane" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + C
end
color = .black
if z escapes then
    color = shade(z, .iterations)
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
while z not escapes do
    z = z^2 + .C
end
color = .black
if z escapes then
    color = shade(z, .iterations)
end

@parameter.tool "Parameter plane external rays" "R" "flare"
.panning = true
# This is nearly a literal copy of
# https://github.com/sagemath/sage/blob/develop/src/sage/dynamics/complex_dynamics/mandel_julia_helper.pyx#L179-L287
# (the angle 2^k p/q is kept exact as the integer a = 2^k p mod q)
R : R = .escapeRadius
q : Z = param_q
for p in param_ps do
    z := R cis(2 pi p / q)
    a : Z = p mod q
    dist : R = error
    k : Z = 0
    while dist >= error do
        k += 1
        a = (2 a) mod q
        j : Z = 0
        while j < S and dist >= error do
            j += 1
            m : R = (k - 1) S + j
            t_m := R^(2^(k - m / S)) cis(2 pi a / q)    # r_m^(2^k) e^(2^(k+1) pi i p/q)
            temp_c := z
            difference : R = error
            C_k := temp_c
            D_k := 1
            for n in 1..iter_limit do
                if difference < error then
                    break
                end
                old_c := temp_c
                C_k = old_c
                D_k = 1
                # C_k = f^k(c) and D_k = d/dc f^k(c), for f(w) = w^2 + c started at c
                for t in 1..k do
                    D_k = 2 D_k C_k + 1
                    C_k = C_k^2 + old_c
                end
                # one step of Newton's method for f^k(c) - t_m
                temp_c = old_c - (C_k - t_m) / D_k
                difference = |old_c - temp_c|
            end
            if difference < error then
                dist = 2 |C_k| log(|C_k|) / |D_k|
                draw line between z and temp_c
                z = temp_c
            else
                dist = 0      # failed to converge, break out of the loops
                draw disk at z with radius error
            end
        end
    end
end

@dynamical.tool "Dynamical plane external rays" "Shift + R" "flare"
.panning = true
R : R = .escapeRadius
q : Z = dyn_q
for p in dyn_ps do
    z = R cis(2 pi p / q)
    a : Z = p mod q
    dist : R = error
    k : Z = 0
    while dist >= error do
        k += 1
        a = (2 a) mod q
        for j in 1..S do
            if dist < error then
                break
            end
            m : R = (k - 1) S + j
            t_m := R^(2^(k - m / S)) cis(2 pi a / q)
            difference : R = error
            temp_z := z
            z_k := 0
            dz_k := 0
            for n in 1..iter_limit do
                if difference < error then
                    break
                end
                old_z := temp_z
                z_k = temp_z
                dz_k = 1
                # z_k = f^k(z) and dz_k = d/dz f^k(z)
                for t in 1..k do
                    dz_k = 2 dz_k z_k
                    z_k = z_k^2 + .C
                end
                # one step of Newton's method for f^k(z) - t_m
                temp_z = old_z - (z_k - t_m) / dz_k
                difference = |old_z - temp_z|
            end
            if difference < error then
                dist = |z - temp_z|
                draw line between z and temp_z
                z = temp_z
            else
                dist = 0      # failed to converge, break out of the loops
                draw disk at z with radius error
            end
        end
    end
end
