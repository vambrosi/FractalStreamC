# Template: a picture of the z-plane. The viewer code runs once per pixel, with z the
# pixel's point, and sets `color`. Replace it with your own (the old app asked for this
# code, and for the title, in a setup dialog).
# Ported from FractalStream examples/templates/one-variable-complex-dynamics.yaml

@config
.title = "One-variable complex dynamics"
.width = 600
.height = 600
.maxIterations = 100          # "Iteration limit"
.escapeRadius = 10            # "Escape radius"
.epsilon = 0.0001             # "Vanishing radius"
plane.radius = 3              # 1/100 per pixel in a 600x600 window

@global
define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)

# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

@viewer plane z "One-variable complex dynamics" "Ctrl + 1"
# ---- your script ----
while z not escapes do
    z = z^2 + i
end

if .stuck then
    color = .black
else if im z > 0 then
    color = light(rainbow(.iterations / 20))
else
    color = dark(rainbow(.iterations / 20))
end
