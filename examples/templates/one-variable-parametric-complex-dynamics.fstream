# Template: a script drawn both in the z-plane and in the C-plane of a complex parameter
# C. Write it once, as the function `picture` below: it gets the starting z, the parameter
# C and `dynamic` (true in the z-plane), and returns the colour. In the C-plane z starts
# at z0. (The old app asked for this code, the title, z0 and the initial C in a setup
# dialog.)
# Ported from FractalStream examples/templates/one-variable-parametric-complex-dynamics.yaml

@config
.title = "Parametric complex dynamics"
.width = 600
.height = 600
.maxIterations = 100          # "Iteration limit"
.escapeRadius = 10            # "Escape radius"
.epsilon = 0.0001             # "Vanishing radius"
.C = 0                        # "Initial value for C" (pick it in the parameter plane)
z0 := 0                       # "Initial value for z in the C plane"
parameter.radius = 3          # 1/100 per pixel in a 600x600 window
dynamical.radius = 3

@global
define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)

# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

define picture(z, C, dynamic : Bool) = color : Color where
    # ---- your script ----
    while z not escapes do
        z = z^2 + C
    end

    if .stuck then
        color = .black
    else if im z > 0 then
        color = light(rainbow(.iterations / 20))
    else
        color = dark(rainbow(.iterations / 20))
    end
end

@viewer parameter C "Parametric complex dynamics parameter plane" "Ctrl + 1"
color = picture(z0, C, false)

@viewer dynamical z "Parametric complex dynamics dynamical plane" "Ctrl + 2"
color = picture(z, .C, true)
