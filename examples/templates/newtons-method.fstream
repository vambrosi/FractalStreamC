# Template: Newton's method for f(z) = 0, colouring each point by the root it converges
# to (basin_color, optionally shaded by the number of steps) or on_failure, with a Trace
# tool. Edit f and the colours in @global (the old app asked for them, and for the title,
# in a setup dialog).
# Ported from FractalStream examples/templates/newtons-method.yaml

@config
.title = "Newton's method on ℂ"
.width = 600
.height = 600
.maxIterations = 100          # "Iteration limit"
.escapeRadius = 10            # "Escape radius"
.epsilon = 0.0001             # "Vanishing radius"
shade_convergence : Bool = true    # "Shade by convergence speed"
plane.radius = 2.34           # 1/128 per pixel in a 600x600 window

@global
define dark(c : Color) = mix(c, .black, 1/3)
define light(c : Color) = mix(c, .white, 1/3)

# the old built-in rainbow: red, orange, yellow, green, teal, blue, purple, violet, red
define rainbow(t : R) = c : Color where
    r : R^9 = [1, 1, 1, 0, 0, 0, 0.5, 1, 1]
    g : R^9 = [0, 0.39, 1, 0.71, 0.5, 0, 0, 0, 0]
    b : R^9 = [0, 0, 0, 0, 0.5, 1, 0.5, 0.63, 0]
    s : R = 8 fract(t)
    k : Z = floor(s) + 1
    c = mix(rgb(r[k], g[k], b[k]), rgb(r[k + 1], g[k + 1], b[k + 1]), fract(s))
end

define f(z) = z^3 - 1                           # "Solve for... 0 ="
define basin_color(z) = rainbow(arg z / (2 pi))  # "Color expression for basins"
define on_failure(z) = .black                   # "Color expression for failure to converge"

define newton(z) = z - f(z) / derivative f at z

@viewer plane z "Newton's method on ℂ" "Ctrl + 1"
lastZ := 0
do
    lastZ = z
    z = newton(z)
while z != lastZ end

if .stuck then
    color = on_failure(z)
else
    color = basin_color(z)
    if shade_convergence then
        color = mix(light(color), dark(color), .iterations / 20)
    end
end

@plane.tool "Trace" "T" "timeline"
prevZ := z
do
    prevZ = z
    draw point at z
    z = newton(z)
    draw line between z and prevZ
while z != prevZ end
