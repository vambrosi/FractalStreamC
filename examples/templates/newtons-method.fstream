# Template: Newton's method for f(z) = 0, colouring each point by the root it converges
# to (basin_color, optionally shaded by the number of steps) or on_failure, with a Trace
# tool. f and the colours are formulas of the config panel (the old app asked for them,
# and for the title, in a setup dialog).
# Ported from FractalStream examples/templates/newtons-method.yaml

@config
.title = "Newton's method on ℂ"
.width = 600
.height = 600
plane.radius = 2.34           # 1/128 per pixel in a 600x600 window

@config "Solve for..."
define f(z) = z^3 - 1

@config "Coloring"
"Color expressions can use color names like .red or .black, and color functions involving the variables z and .iterations."
define basin_color(z) = rainbow(arg z / (2 pi))
define on_failure(z) = .black

@config "Configuration"
shade_convergence : Bool = true "Shade by convergence speed"

@config "Standard options"
.maxIterations = 100 "Iteration limit"
.escapeRadius = 10 "Escape radius"
.epsilon = 0.0001 "Vanishing radius"

@global
define newton(z) = z - f(z) / derivative f at z

@viewer plane z "Newton's method on ℂ" "Ctrl + 1"
lastZ := 0
do
    lastZ = z
    z = newton(z)
while z != lastZ end

if .stuck then
    color = on_failure(z)
else
    color = basin_color(z)
    if shade_convergence then
        color = blend(.iterations / 20, dark(color), light(color))
    end
end

@plane.tool "Trace" "T" "timeline"
prevZ := z
do
    prevZ = z
    draw point at z with color .white
    z = newton(z)
    draw line between z and prevZ with color .white
while z != prevZ end
on show do                    # (selected, or the config or the view changed)
    erase
end
on hide do
    erase
end
