# The Douady rabbit again, written with a long line
# split over several lines (the old script tested the
# `...` line continuation; here an open parenthesis does
# it).
# Ported from FractalStream examples/ellipsis.yaml

@config
.title = "Douady rabbit"
.width = 400
.height = 425
.maxIterations = 100
plane.radius = 1.5625

@viewer plane z "Douady rabbit" "Ctrl + 1"
# Iterate until we escape or loop 100 times
while |z| < 10 do
    z = (z^2 - 0.12256
              + 0.74486
              i)
end

# If we didn't escape in 100 loops, draw a black point.
# Otherwise, draw a white point.
if .iterations == 100 then
    color = .black
else
    color = .white
end
