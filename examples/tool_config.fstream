# A Julia set with two tools: "Demo" draws a circle and a radius set in the config panel,
# and "Trace" draws the orbit of the clicked point.
# (The original demonstrated tools with their own configuration panel, redrawn whenever
# that configuration changed; here the variables are in the main config panel.)
# Ported from FractalStream examples/tool_config.yaml

@config
.title = "Julia set"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10
C := -0.11 + 0.78i            # f(z) = z^2 + C
p : R = 0.5 in 0.05..2        # "Brightness"
R : R = 1                     # Demo tool: "R ="
theta : R = pi / 4            # Demo tool: "θ ="

@viewer plane z "Julia set" "Ctrl + 1"
while z not escapes do
    z = z^2 + C
end
if .stuck then
    color = .black
else
    color = mix(.white, mix(.blue, .black, 1/3), (.iterations / .maxIterations)^p)
end

@plane.tool "Demo" "X" "architecture"
# click anywhere to draw (the original redrew on every change of R or theta)
draw circle at 0 with radius R
draw line between 0 and R cis(theta)

@plane.tool "Trace" "T" "timeline"
prevZ := z
for k in 1..100 do
    if |z| >= 10 .escapeRadius then
        break
    end
    prevZ = z
    draw point at z
    z = z^2 + C
    draw line between z and prevZ
end
