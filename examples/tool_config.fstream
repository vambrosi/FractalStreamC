# A Julia set with two tools: "Demo" draws a circle and a radius set in its own group of
# the config panel (redrawn whenever they change), and "Trace" draws the orbit of the
# clicked point.
# Ported from FractalStream examples/tool_config.yaml

@config
.title = "Julia set"
.width = 512
.height = 512

@config "Configuration"
C := -0.11 + 0.78i "f(z) = z^2 +"
.maxIterations = 100 "Max. iterations"
.escapeRadius = 10 "Escape radius"
p : R = 0.5 in 0.05..2 "Brightness"

@config "Demo tool"
R : R = 1
theta : R = pi / 4 "θ"

@viewer plane z "Julia set" "Ctrl + 1"
while z not escapes do
    z = z^2 + C
end
if .stuck then
    color = .black
else
    color = blend((.iterations / .maxIterations)^p, dark(.blue), .white)
end

@plane.tool "Demo" "X" "architecture"
.panning = true
on show do
    draw circle at 0 with radius R
    draw line between 0 and R cis(theta)
end
on hide do
    erase
end

@plane.tool "Trace" "T" "timeline"
prevZ := z
for k in 1..100 do
    if |z| >= 10 .escapeRadius then
        break
    end
    prevZ = z
    draw point at z
    z = z^2 + C
    draw line between z and prevZ
end
