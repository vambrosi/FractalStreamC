# Compares two cyclic colour maps, the old "rainbow" and the "Arenberg" phase wheel, on a
# reference strip and on the Mandelbrot and Julia sets (smooth escape-time colouring).
# Ported from FractalStream examples/arenberg-test.yaml

@config
.title = "Arenberg rainbow test"
.width = 640
.height = 512
.maxIterations = 100
.escapeRadius = 10
use_arenberg : Bool = false   # "Use Arenberg rainbow"
speed : R = 20 in 1..100      # "Iterations per color cycle"
.C = -0.11 + 0.78i            # f(z) = z^2 + C (pick it in the parameter plane)

@global
# a wheel of 8 colours, one turn per unit of t (the old built-in colour maps)
define wheel(t : R, c1 : Color, c2 : Color, c3 : Color, c4 : Color,
             c5 : Color, c6 : Color, c7 : Color, c8 : Color) = c : Color where
    s : R = 8 fract(t)
    u : R = fract(s)
    k : Z = floor(s)
    if k == 0 then
        c = mix(c1, c2, u)
    else if k == 1 then
        c = mix(c2, c3, u)
    else if k == 2 then
        c = mix(c3, c4, u)
    else if k == 3 then
        c = mix(c4, c5, u)
    else if k == 4 then
        c = mix(c5, c6, u)
    else if k == 5 then
        c = mix(c6, c7, u)
    else if k == 6 then
        c = mix(c7, c8, u)
    else
        c = mix(c8, c1, u)
    end
end

define rainbow(t : R) = wheel(t, rgb(255, 0, 0) / 255, rgb(255, 100, 0) / 255,
                              rgb(255, 255, 0) / 255, rgb(0, 180, 0) / 255,
                              rgb(0, 128, 128) / 255, rgb(0, 0, 255) / 255,
                              rgb(128, 0, 128) / 255, rgb(255, 0, 160) / 255)

# sampled from 8 points of the Arenberg phase wheel
# (https://eprovst.github.io/DomainColoring.jl/stable/arenberg/#The-Arenberg-Phase-Wheel)
define arenberg(t : R) = wheel(t, rgb(255, 80, 81) / 255, rgb(255, 174, 0) / 255,
                               rgb(152, 190, 0) / 255, rgb(0, 183, 74) / 255,
                               rgb(0, 237, 232) / 255, rgb(0, 172, 255) / 255,
                               rgb(184, 161, 255) / 255, rgb(255, 134, 226) / 255)

define palette(t : R) = c : Color where
    if use_arenberg then
        c = arenberg(t)
    else
        c = rainbow(t)
    end
end

@viewer parameter C "Parameter plane" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + C
end
color = .black
if z escapes then
    m : R = .iterations + 1 - log(log(|z|^2) / (2 log(10))) / log(2)
    color = palette(m / speed)
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
while z not escapes do
    z = z^2 + .C
end
color = .black
if z escapes then
    m : R = .iterations + 1 - log(log(|z|^2) / (2 log(10))) / log(2)
    color = palette(m / speed)
end

@viewer reference x "Reference" "Ctrl + 3"
color = palette(re x / 4)
