# The Mandelbrot set, coloured by escape time.
@config
.title = "Mandelbrot set"
.maxIterations = 500
plane.center = -0.5
plane.radius = 1.5

@viewer plane c "Parameter plane" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + c
end
if .stuck then
    color = .black
else
    t : R = .iterations / 50
    color = hsv(t, 0.8, 1)
end
