# The Douady rabbit composed with a Dehn twist: after each step of z -> z^2 + C, the
# annulus r0 < |z - twist_center| < r1 is twisted once around. Escaping points are
# coloured by smooth escape time, in blue/green above the real axis and yellow/red below.
# Ported from FractalStream examples/twisted_rabbit.yaml

@config
.title = "Twisted rabbit"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10            # "Max. radius"
C := -0.1226 + 0.7449i
twist_center := -0.267 + 0.478i    # "Center of twist"
r0 : R = 0.2                  # "Inner radius"
r1 : R = 0.5                  # "Outer radius"

@global
define f(z) = z^2 + C                      # "Iterate f(z) ="
define stop(z) = |z| > .escapeRadius       # "until"

@viewer plane z "Twisted rabbit" "Ctrl + 1"
while not stop(z) do
    z = f(z)
    d : R = |z - twist_center|
    if d > r0 and d < r1 then
        theta : R = 2 pi (d - r0) / (r1 - r0)
        z = cis(theta) (z - twist_center) + twist_center
    end
end

if .stuck then
    color = .black
else
    c1 : Color = .yellow
    c2 : Color = .red
    if im z > 0 then
        c1 = .blue
        c2 = .green
    end
    s : R = .iterations + 1 - log(log(|z|^2 / 2)) / log(2)
    s = cos(s pi / 10)^2
    color = mix(c2, c1, s)
end
