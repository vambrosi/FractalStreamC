# Test of list values: the circle picture, plus a tool
# that draws a unit circle around each point of a list
# of centres.
# Ported from FractalStream examples/list-test.yaml

@config
.title = "Circle"
.width = 512
.height = 512

@config "Configuration"
myList : List of C = [0, 1, i] "Centers"

@viewer plane z "Circle" "Ctrl + 1"
if |z| < 1 then
    color = .red
else if im z > 0 then
    color = .green
else
    color = .blue
end

@plane.tool "Show circles" "S" "bubble_chart"
.panning = true
# when selected, and whenever the config changes
on show do
    for center in myList do
        draw circle at center with radius 1
    end
end
