# The complex Hénon map (x, y) -> (x^2 + b - a y, x), in
# the style of FractalStream 1.0: the parameter plane is
# the b-plane (b = c, a fixed). Each orbit starts at the
# fixed point (p, p) moved by zoom z along the expanding
# eigenvector (lambda, 1), with z = 0 in the parameter
# plane and z = the pixel in the dynamical plane, and is
# coloured by escape time (1.0 coloured the reported x
# with settings kept in the app, not in the script).
# Ported from FractalStream
# notes/fractalstream-1.0-scripts/henonc.txt

@config
.title = "Hénon map, b-plane"
.maxIterations = 100
.escapeRadius = 10
# the b of the dynamical plane (pick it in the b-plane)
.c = 0.6 + 0.2i
a : C = 0.3                   # "default a to 0.3."
zoom : R = 0.001              # "default zoom to 0.001."

@global
# iterate from the fixed point moved by `step` along the
# unstable direction; the result is the number of steps
# before x escapes (.maxIterations if it does not)
define henon(a, b, step) = n : Z where
    aa := (a + 1) / 2
    disc := aa^2 - b
    p := sqrt(disc) + aa
    disc = p^2 - a
    lambda := sqrt(disc) + p
    x := p + lambda step
    y := p + step
    do
        t := x
        x = x^2 + b - a y
        y = t
    while x not escapes end
    n = .iterations
    if x not escapes then
        n = .maxIterations
    end
end

@viewer parameter c "b-plane" "Ctrl + 1"
n : Z = henon(a, c, 0)        # "set b to c."
color = .black
if n < .maxIterations then
    color = cycle(n / 10, .blue, .white)
end

@viewer dynamical z "Dynamical plane" "Ctrl + 2"
n : Z = henon(a, .c, z zoom)
color = .black
if n < .maxIterations then
    color = hsv(n / 10, 0.8, 1)
end
