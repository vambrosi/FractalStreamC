# Thurston's spider algorithm for θ = p/q (an unfinished experiment in the original).
# "Draw standard spider" draws the legs at the angles 2^k θ and the kneading sequence of θ;
# "Reset spider" moves the first foot to 0 and draws the contour γ (the preimage of the
# first leg); "Apply spider map" pulls the spider back once.
# Ported from FractalStream examples/spider.yaml

@config
.title = "Spider algorithm"
.width = 512
.height = 512

@config "Input θ = p / q for S_θ"
p : Z = 9
q : Z = 56

@config "Computed values"
kneading : List of Z up to 1024 = [] "Kneading sequence (0: ⋆₁, 1: ⋆₂, 2: A, 3: B)"
preperiod : Z = 0 "Preperiod"
period : Z = 0 "Period"

@config "Configuration"
spider_ready : Bool = false "Spider representative ready?"
encloses_zero : Bool = false "Encloses 0?"
.maxIterations = 1000 "Max. iterations"
foot : R = 0.03 "Foot radius"

@global
# The spider: a list of legs, each going from its foot outwards. There are no lists of
# lists, so the legs follow each other in `spider`: leg j is spider[leg_start[j]] up to
# spider[leg_start[j + 1] - 1].
spider : List of C up to 4096 = []
leg_start : List of Z up to 1024 = []
contour : List of C up to 256 = []      # γ
spider_p : Z = 0                        # the θ the spider was made for
spider_q : Z = 0
redraw_spider : Bool = false            # set by "Apply spider map"
# what the original wrote in the view after applying the spider map (for the first leg)
shown_w := 0
shown_zero_winding : Z = 0
shown_sqrt_sign : Z = 0
shown_last_pre := 0

# The preperiod and period of θ = p/q under doubling, and the kneading sequence of
# 2^k θ (k = 0 .. preperiod + period - 1). Works with 2p / 2q, so that the two preimages
# of θ are h1 / 2q and h2 / 2q. The result is the number of legs.
define analyse_theta() = n : Z where
    P2 : Z = 2 p
    Q2 : Z = 2 q
    h2 : Z = p
    h1 : Z = p + q
    star2 := cis(2 pi h2 / Q2)

    # Brent's cycle detection algorithm
    power : Z = 1
    period = 1
    tortoise : Z = P2
    hare : Z = (2 P2) mod Q2
    while tortoise != hare do
        if power == period then
            tortoise = hare
            power = 2 power
            period = 0
        end
        hare = (2 hare) mod Q2
        period += 1
    end
    tortoise = P2
    hare = P2
    for k in 1..period do
        hare = (2 hare) mod Q2
    end
    preperiod = 0
    while tortoise != hare do
        tortoise = (2 tortoise) mod Q2
        hare = (2 hare) mod Q2
        preperiod += 1
    end

    # Now period is the length of the periodic part, and preperiod the length of the
    # preperiodic part.
    n = preperiod + period
    clear(kneading)
    t : Z = P2
    for k in 1..n do
        omega := cis(2 pi t / Q2)
        if t == h1 then
            append(kneading, 0)
        else if t == h2 then
            append(kneading, 1)
        else if re(i star2 conj(omega)) > 0 then
            append(kneading, 2)
        else
            append(kneading, 3)
        end
        t = (2 t) mod Q2
    end
end

# the preimage of w under P(z) = z2 (1 + z/2)^2 closest to `near`
define pullback(w, z2, near) = pre where
    pre1 := -2 + 2 sqrt(w / z2)
    pre2 := -2 - 2 sqrt(w / z2)
    pre = if |pre1 - near| < |pre2 - near| then pre1 else pre2
end

# The contour γ: the inverse image of the first leg γ_1 under P(z) = z2 (1 + z/2)^2.
# Since γ_1 starts at z_1 = 0 and 0 is the critical value of P, it is a curve that splits
# the sphere in half, through infinity and -2. We compute a hopefully-big-enough part of
# it, from the points of γ_1 from the k0-th on, and close it with a rectangle on the right:
#   ____________________________________
#   \                                   |
#    \__                                |
#       \                               |
#        \______________________________|
#
# With k0 = 2 (after the spider map) -2 itself is added in the middle. Also finds whether
# γ winds around 0.
define make_contour(z2, k0 : Z) = n : Z where
    a : Z = leg_start[1] + k0 - 1
    e : Z = leg_start[2] - 1
    clear(contour)
    half : List of C up to 128 = []
    last_pre := -2 + 2 sqrt(spider[a] / z2)
    for k in a..e do
        last_pre = pullback(spider[k], z2, last_pre)
        append(half, last_pre)
    end
    for k in |half|..1 by -1 do
        append(contour, half[k])
    end
    if k0 == 2 then
        append(contour, -2)
    end
    last_pre = -2 - 2 sqrt(spider[a] / z2)
    for k in a..e do
        last_pre = pullback(spider[k], z2, last_pre)
        append(contour, last_pre)
    end
    first_pt := contour[1]
    last_pt := contour[-1]
    append(contour, 10 + i im last_pt)
    append(contour, 10 + i im first_pt)
    append(contour, first_pt)

    # Determine if the contour encloses 0 or not
    integral := 0
    for k in 2..|contour| do
        integral += (contour[k] - contour[k - 1]) / contour[k - 1]
    end
    encloses_zero = im integral > 0
    n = |contour|
end

# draw γ in light grey, with -2 marked
define draw_contour() = n : Z where
    for k in 2..|contour| do
        draw line between contour[k - 1] and contour[k] with color light(.gray)
    end
    draw point at -2 with color light(.gray)
    draw text "-2" at -2.2 with color light(.gray)
    draw text "γ" at contour[1] - 0.15i with color light(.gray)
    n = |contour|
end

# The old "activated" event of "Reset spider": the standard spider with its first foot
# moved to 0 (leg j is t -> R^(1 - t) omega_j + b t), drawn as it is made, then γ.
define reset_spider() = n : Z where
    n = analyse_theta()
    R : R = 10
    N : Z = 100                       # points per leg
    if n (N + 1) > 4096 then          # (lists hold at most 4096 points)
        N = floor(4096 / n) - 1
    end
    b := -cis(2 pi p / q)             # moves the first foot to 0
    omega := cis(2 pi p / q)
    clear(spider)
    clear(leg_start)
    for j in 1..n do
        c := rainbow((j - 1) / n)
        last_gamma := R omega
        draw line between 20 omega and last_gamma with color dark(c)
        for k in 1..N do
            t : R = k / N
            gamma := R^(1 - t) omega + b t
            draw line between last_gamma and gamma with color dark(c)
            last_gamma = gamma
        end
        draw disk at omega + b with radius foot and color light(c)
        draw circle at omega + b with radius foot and color dark(c)
        # the leg, from the foot outwards: gamma((N - 1)/N) .. gamma(0)
        append(leg_start, |spider| + 1)
        for k in N - 1..0 by -1 do
            t : R = k / N
            append(spider, R^(1 - t) omega + b t)
        end
        omega = omega^2
    end
    append(leg_start, |spider| + 1)

    omega = cis(2 pi p / q)
    m : Z = make_contour(omega^2 + b, 1)
    m = draw_contour()
    spider_p = p
    spider_q = q
    spider_ready = true
end

# the old "Apply spider map" button: pull the spider back by P(z) = z_2 (1 - z/2)^2
define apply_spider_map() = n : Z where
    n = |leg_start| - 1
    z_2 := spider[leg_start[2]]
    new_spider : List of C up to 4096 = []
    new_start : List of Z up to 1024 = []
    for j in 1..n do
        # To compute the new z_j and γ_j, we need to pick one of the two preimages of
        # z_(j+1) and γ_(j+1) under P (leg j + 1, cyclically).
        a : Z = leg_start[(j mod n) + 1]
        e : Z = leg_start[(j mod n) + 2] - 1
        z_jp1 := spider[a]

        # See which preimage -2 +/- 2 sqrt(z_(j+1) / z_2) is inside the contour
        w := -2 + 2 sqrt(z_jp1 / z_2)
        integral := 0
        for k in 2..|contour| do
            integral += (contour[k] - contour[k - 1]) / (contour[k] - w)
        end
        zero_winding : Z = if encloses_zero then 1 else -1
        sqrt_sign : Z = if im integral > 0 then 1 else -1

        # Determine if we should pick the preimage inside or outside the contour based on
        # the jth term of the kneading sequence. If it was A, pick the preimage with
        # sqrt_sign. If it was B, pick the preimage with negated sqrt_sign.
        # TODO (in the original): deal with the ⋆s in the kneading sequence
        symbol : Z = kneading[j]
        last_pre := 0
        if symbol == 2 then
            last_pre = -2 + 2 sqrt_sign zero_winding sqrt(z_jp1 / z_2)
        else if symbol == 3 then
            last_pre = -2 - 2 sqrt_sign zero_winding sqrt(z_jp1 / z_2)
        end
        if j == 1 then
            shown_w = w
            shown_zero_winding = zero_winding
            shown_sqrt_sign = sqrt_sign
            shown_last_pre = last_pre
        end

        # Try to rescale the new spider so that it is roughly the same size as the old one
        scale : R = sqrt(10)
        append(new_start, |new_spider| + 1)
        append(new_spider, scale last_pre)
        for k in a + 1..e do
            last_pre = pullback(spider[k], z_2, last_pre)
            append(new_spider, scale last_pre)
        end
        # Add one more segment to the leg so that we reach at least radius 10
        if |last_pre| < 10 then
            append(new_spider, 10 scale last_pre / |last_pre|)
        end
    end
    append(new_start, |new_spider| + 1)
    spider = new_spider
    leg_start = new_start

    # Recompute the contour γ
    m : Z = make_contour(spider[leg_start[2]], 2)
end

# draw the spider, γ, and the values the original wrote (the spider after the map)
define draw_spider() = n : Z where
    n = |leg_start| - 1
    for j in 1..n do
        c := rainbow((j - 1) / n)
        for k in leg_start[j] + 1..leg_start[j + 1] - 1 do
            draw line between spider[k - 1] and spider[k] with color dark(c)
        end
        draw disk at spider[leg_start[j]] with radius foot and color light(c)
        draw circle at spider[leg_start[j]] with radius foot and color dark(c)
    end
    m : Z = draw_contour()
    draw text "w: " + shown_w at 1 with color .black
    draw text "zero_winding: " + shown_zero_winding at 1 - 0.3i with color .black
    draw text "sqrt_sign: " + shown_sqrt_sign at 1 - 0.6i with color .black
    draw text "last_pre: " + shown_last_pre at 1 - 0.9i with color .black
end

@viewer standard z "Standard spider" "Ctrl + 1"
color = .white

@viewer iterated z "Iterated spider" "Ctrl + 2"
color = .white

@standard.tool "Draw standard spider" "S" "pest_control"
.panning = true
on show do
    n := analyse_theta()
    star1 := cis(2 pi (p + q) / (2 q))
    star2 := cis(2 pi p / (2 q))
    draw circle at 0 with radius 1 and color .gray
    draw line between star1 and star2 with color .gray
    draw text "A" at i star2 / 2 with color .black
    draw text "B" at -i star2 / 2 with color .black

    # the legs at the angles 2^k θ, coloured around the rainbow
    t : Z = 2 p
    for k in 1..n do
        omega := cis(2 pi t / (2 q))
        c := rainbow((k - 1) / n)
        draw line between omega and 10 omega with color dark(c)
        draw disk at omega with radius foot and color light(c)
        draw circle at omega with radius foot and color dark(c)
        t = (2 t) mod (2 q)
    end

    # the kneading sequence, written under the circle (the old app showed it in the
    # config panel), with its periodic part in brackets
    dx : R = 2 / (n + 2)
    draw text "[" at -1 + dx (preperiod + 0.5) - 1.3i with color .black
    draw text "]" at -1 + dx (n + 1.5) - 1.3i with color .black
    for k in 1..n do
        x : R = -1 + dx (k - 0.5)
        if k > preperiod then
            x += dx
        end
        s : Z = kneading[k]
        if s == 0 then
            draw text "⋆₁" at x - 1.3i with color .black
        else if s == 1 then
            draw text "⋆₂" at x - 1.3i with color .black
        else if s == 2 then
            draw text "A" at x - 1.3i with color .black
        else
            draw text "B" at x - 1.3i with color .black
        end
    end
end

@iterated.tool "Reset spider" "R" "restart_alt"
.panning = true
.keep = true                  # drawings stay until erased, as in the old tool
on show do                    # (the old "activated" and "refresh")
    if not spider_ready or spider_p != p or spider_q != q then
        erase
        n := reset_spider()
    else if redraw_spider then
        erase
        n := draw_spider()
        redraw_spider = false
    end
end
on hide do
    spider_ready = false      # selecting the tool again resets the spider
end

@iterated.tool "Apply spider map" "A" "redo" button
if spider_ready then
    n := apply_spider_map()
    redraw_spider = true      # "Reset spider" draws it
end
