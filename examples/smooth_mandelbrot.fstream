# The Mandelbrot set with smooth (continuous) escape-time colouring, from red to white.
# Ported from FractalStream examples/smooth_mandelbrot.yaml

@config
.title = "Mandelbrot set with smooth coloring"
.width = 512
.height = 512
.maxIterations = 100
.escapeRadius = 10

@viewer plane C "Mandelbrot set" "Ctrl + 1"
z := 0
while z not escapes do
    z = z^2 + C
end
if z escapes then
    # see https://linas.org/art-gallery/escape/ray.html
    m : R = .iterations + 1 - log(log(|z|^2) / (2 log(.escapeRadius))) / log(2)
    color = mix(.white, .red, 2 atan(m / 20) / pi)
else
    color = .black
end
