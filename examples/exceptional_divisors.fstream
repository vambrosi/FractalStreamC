# "Xavier's exceptional divisors": the t-plane shows the basins of the cube roots of 1
# for t -> t (2 + t^3) / (2 t^3 + 1); the z-plane runs a map of two variables (x, y),
# started at (t/2z, 1/2z), and colours each point by the basin it lands in, refining the
# basins of x = -1, -j, -jbar by a one-variable cubic map.
# Ported from FractalStream examples/exceptional_divisors.yaml (itself a translation of
# the "Xavier's Exceptional Divisors" script of the original FractalStream)

@config
.title = "Exceptional divisors"
.width = 512
.height = 512
.maxIterations = 100          # "Iteration limit"
.escapeRadius = 10            # "Escape radius"
.epsilon = 0.01               # "Tolerance"
.t = 1 + i                    # "t = " (pick it in the t-plane)
tcolor1 : Color = .red        # t-plane colours: 1
tcolor2 : Color = .green      #   ω
tcolor3 : Color = .blue       #   ω²
zcol : Color = .yellow        # z-plane colours: "escaped" (used for x = 0)
color8 : Color = .red         #   "inf"
color9 : Color = .green       #   "j"
color10 : Color = .blue       #   "jbar"
exceptional : Color = rgb(1, 0.7, 0.7)

@global
j := -1/2 + i sqrt(3) / 2
jbar := -1/2 - i sqrt(3) / 2

# iterate w -> 2 w^3 / 3 + w^2 + 2 w + k until it escapes or reaches j or jbar
define refine(w, k) = c : Color where
    while not (w escapes or w == j or w == jbar) do
        w = 2 w^3 / 3 + w^2 + 2 w + k
    end
    if w escapes then
        c = color8
    else if w == j then
        c = color9
    else if w == jbar then
        c = color10
    else
        c = .black
    end
end

@viewer tplane t "t-plane" "Ctrl + 1"
while t^3 != 1 do
    t = t (2 + t^3) / (2 t^3 + 1)
end

if t == 1 then
    color = tcolor1
else if t == j then
    color = tcolor2
else if t == jbar then
    color = tcolor3
else
    color = .black
end

@viewer zplane z "z-plane" "Ctrl + 2"
y := 0.5 / z
x := 0.5 .t / z

while not (x == 0 or x^3 == -1 or x^3 == 1/8) do
    w := -3 x (2 y^3 + x^3) / ((1 - 6 x y) - 4 (x^3 + y^3) + 6 x^2 y^2)
    y = -3 y (2 x^3 + y^3) / ((1 - 6 x y) - 4 (x^3 + y^3) + 6 x^2 y^2)
    x = w
end

if x == 0 then
    color = zcol
else if x == -1 then
    color = refine((y + 1) / (x - y), 1/3)
else if x == -j then
    # (sic: the original adds w/3 here instead of 1/3, so the map depends on w)
    w := (y / jbar + 1) / (x / j - y / jbar)
    while not (w escapes or w == j or w == jbar) do
        w = 2 w^3 / 3 + w^2 + 2 w + w / 3
    end
    if w escapes then
        color = color8
    else if w == j then
        color = color9
    else if w == jbar then
        color = color10
    else
        color = .black
    end
else if x == -jbar then
    # (the original's exit test reads `w = j or j = jbar`, which stops at the same places)
    color = refine((y / j + 1) / (x / jbar - y / j), 1/3)
else if x^3 == 1/8 then
    color = exceptional
else
    color = .black
end
