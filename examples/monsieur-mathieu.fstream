# One step of the "Monsieur Mathieu" rational map of degree 12, colouring each point by
# where it lands: near 0 (blue), near 1 (red), on the segment (0, 1) (green), in the upper
# half plane (white) or in the lower half plane (black).
# Ported from FractalStream examples/monsieur-mathieu.yaml

@config
.title = "Monsieur Mathieu"
.width = 512
.height = 512

@config "Configuration"
tol : R = 0.01 in 0.0001..0.1 "Tolerance"

@global
a := (107 + 7 sqrt(11) i) / 486
b := -13 a / 567 + 5 / 1701
d := 23 a / 7 + 256 / 567
ee := -1573 a / 567 + 605 / 1701
f := -17 / 9
k := -16192 a / 301327047 + 10880 / 903981141

@viewer plane z "Monsieur Mathieu" "Ctrl + 1"
z = (z^3 - z^2 + a z + b)^3 (z^3 + f z^2 + d z + ee) / (k z)

# (the original tests `z = tol`, that is |z - tol| < tol)
if |z - tol| < tol then
    color = .blue
else if |z - 1| < tol then
    color = .red
else if |im z| < tol and re z > 0 and re z < 1 then
    color = .green
else if im z > 0 then
    color = .white
else
    color = .black
end
